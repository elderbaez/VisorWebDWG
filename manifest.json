{
  "name": "Visor web DWG/DXF",
  "short_name": "Visor DWG",
  "description": "Visor de archivos DWG y DXF en la web",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#1b1b1b",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["productivity", "utilities"],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/acad": [".dwg"],
        "application/dxf": [".dxf"],
        "application/octet-stream": [".dwg", ".dxf"]
      }
    }
  ]
}
